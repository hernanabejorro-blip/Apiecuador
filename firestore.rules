rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Diagnóstico técnico: cada usuario accede solo a su documento.
    match /users/{userId}/diagnostico/{document=**} {
      allow read, write: if request.auth != null
                         && request.auth.uid == userId;
    }

    // Piloto aislado de apiarios en la nube. No abre otras colecciones.
    match /users/{userId}/apiariosPiloto/{document=**} {
      allow read, write: if request.auth != null
                         && request.auth.uid == userId;
    }

    // Todo lo demás permanece bloqueado hasta definir reglas específicas.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}